@startuml
left to right direction

actor Admin
actor Lead
actor "Asterisk PBX" as PBX
actor "AI Microservice" as AIService

rectangle "AI Call Qualification System" {
usecase "Add Lead" as AddLead
usecase "View Leads Dashboard" as ViewLeads
usecase "Initiate Outbound Call" as InitiateCall
usecase "Route Call via SIP" as RouteCall
usecase "Capture Voice Response" as CaptureVoice
usecase "Convert Speech to Text" as STT
usecase "Recognize Intent" as DetectIntent
usecase "Generate AI Reply" as GenReply
usecase "Convert Text to Speech" as TTS
usecase "Play Response to Lead" as PlayVoice
usecase "Update Lead Status" as UpdateStatus
}

Admin -- AddLead
Admin -- ViewLeads
Admin -- InitiateCall
Admin -- UpdateStatus

InitiateCall -- PBX
RouteCall -- PBX
CaptureVoice -- PBX
CaptureVoice -- Lead
STT -- AIService
DetectIntent -- AIService
GenReply -- AIService
TTS -- AIService
PlayVoice -- PBX

@enduml