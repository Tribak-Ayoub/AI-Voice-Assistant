@startuml
left to right direction
skinparam packageStyle rectangle

actor "Admin (Propriétaire de l'app)" as Admin
actor "Client (Entreprise abonnée)" as Client

rectangle "Système IA de Qualification des Leads" {

  usecase "Gérer les clients" as UC1
  usecase "Gérer les abonnements et paiements" as UC2
  usecase "Créer et gérer les campagnes" as UC3
  usecase "Gérer des leads" as UC4
  usecase "Superviser les appels en temps réel" as UC5
  usecase "Accéder au tableau de bord Admin" as UC6
  usecase "Consulter les appels" as UC7
  usecase "Initier un appel sortant" as UC8
  usecase "Accéder au tableau de bord Client" as UC9
  usecase "Consulter les statuts" as UC10
}

' === Associations ===
Admin -- UC1
Admin -- UC2
Admin -- UC6

Client -- UC3
Client -- UC4
Client -- UC5

Client -- UC9
Client -- UC7
Client -- UC8

UC4 -- UC10 : <<include>>
@enduml
